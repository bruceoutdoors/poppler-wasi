# Pinned build inputs. Sourced by every script in scripts/ and hashed into CI cache keys.
#
# NOTE: the Poppler version is deliberately absent. It lives in exactly two places:
#   1. the third_party/poppler submodule pin (a commit SHA in the git index), and
#   2. scripts/check-upstream.sh, which discovers the newest stable tag at runtime.
# Nothing here should ever need editing when a new Poppler release lands.

WASI_SDK_VERSION=33.0
WASI_SDK_MAJOR=33

# Poppler only sets a floor for FreeType (find_package(Freetype <ver> REQUIRED), currently 2.13)
# and no constraint at all for zlib, so these exact versions are our choice, for reproducible
# builds. Newest stable is a fine default. build.sh fails with an actionable message if a poppler
# bump raises the FreeType floor above this pin.
FREETYPE_VERSION=2.15.0
FREETYPE_SHA256=93cd47eb719c325107f2d3cf087d06299e944c3b48a40b55537302304dea1dd5

ZLIB_VERSION=1.4
ZLIB_SHA256=4f11c512053d7bab8d9e9b89bde3575add3e4c50a383b42ef6cb837035fc5a7c

# Runtime used to run the test suite in CI.
WASMTIME_VERSION=47.0.2
